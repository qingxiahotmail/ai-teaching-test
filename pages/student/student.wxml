<!--student.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">学生管理</text>
    <text class="page-subtitle">管理班级学生信息</text>
  </view>

  <!-- 统计概览 -->
  <view class="stats-overview">
    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-value">{{stats.totalStudents || 0}}</text>
        <text class="stat-label">学生总数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.maleCount || 0}}</text>
        <text class="stat-label">男生</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.femaleCount || 0}}</text>
        <text class="stat-label">女生</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.classCount || 0}}</text>
        <text class="stat-label">班级数</text>
      </view>
    </view>
  </view>

  <!-- 搜索和筛选区域 -->
  <view class="filter-section">
    <view class="filter-row">
      <picker class="class-picker" range="{{classOptions}}" value="{{selectedClassIndex}}" bindchange="onClassChange">
        <view class="picker-display">{{selectedClass || '选择班级'}}</view>
      </picker>
      
      <picker class="status-picker" range="{{statusOptions}}" value="{{selectedStatusIndex}}" bindchange="onStatusChange">
        <view class="picker-display">{{selectedStatus || '学生状态'}}</view>
      </picker>
    </view>
    
    <view class="search-box">
      <input class="search-input" placeholder="搜索学生姓名或学号" bindinput="onSearchInput" value="{{searchKeyword}}" />
      <image class="search-icon" src="/images/search.png"></image>
    </view>
  </view>

  <!-- 添加学生按钮 -->
  <view class="add-student-section">
    <button class="add-student-btn" bindtap="showAddStudentModal">
      <image class="add-icon" src="/images/add.png"></image>
      <text>添加学生</text>
    </button>
  </view>

  <!-- 学生列表 -->
  <view class="student-list">
    <view wx:for="{{filteredStudents}}" wx:key="id" class="student-card">
      <!-- 学生基本信息 -->
      <view class="student-info">
        <image class="avatar" src="{{item.avatar || '/images/default_avatar.png'}}"></image>
        <view class="info-details">
          <view class="name-section">
            <text class="student-name">{{item.name}}</text>
            <text class="student-id">{{item.studentId}}</text>
          </view>
          <view class="details-section">
            <text class="class-name">{{item.className}}</text>
            <text class="gender {{item.gender}}">{{item.gender === 'male' ? '男' : '女'}}</text>
          </view>
        </view>
      </view>

      <!-- 学生联系方式 -->
      <view class="contact-info">
        <view class="contact-item">
          <image class="contact-icon" src="/images/phone.png"></image>
          <text class="contact-text">{{item.phone || '未填写'}}</text>
        </view>
        <view class="contact-item">
          <image class="contact-icon" src="/images/email.png"></image>
          <text class="contact-text">{{item.email || '未填写'}}</text>
        </view>
      </view>

      <!-- 学生状态 -->
      <view class="student-status">
        <text class="status-badge {{item.status === 'active' ? 'active' : 'inactive'}}">
          {{item.status === 'active' ? '在读' : '休学'}}
        </text>
        <text class="enrollment-date">入学：{{item.enrollmentDate}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="action-buttons">
        <button class="action-btn edit-btn" bindtap="editStudent" data-student="{{item}}">编辑</button>
        <button class="action-btn delete-btn" bindtap="deleteStudent" data-id="{{item.id}}">删除</button>
        <button class="action-btn detail-btn" bindtap="viewStudentDetail" data-id="{{item.id}}">详情</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{filteredStudents.length === 0}}">
    <image class="empty-icon" src="/images/empty_student.png"></image>
    <text class="empty-text">暂无学生数据</text>
    <text class="empty-subtext">点击上方按钮添加学生</text>
  </view>

  <!-- 添加/编辑学生模态框 -->
  <view class="modal {{showStudentModal ? 'show' : ''}}">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">{{editingStudent ? '编辑学生信息' : '添加学生'}}</text>
        <button class="close-btn" bindtap="hideStudentModal">×</button>
      </view>
      
      <view class="modal-body">
        <view class="form-group">
          <text class="form-label">学生姓名</text>
          <input class="form-input" placeholder="请输入学生姓名" value="{{studentForm.name}}" bindinput="onFormInput" data-field="name" />
        </view>
        
        <view class="form-group">
          <text class="form-label">学号</text>
          <input class="form-input" placeholder="请输入学号" value="{{studentForm.studentId}}" bindinput="onFormInput" data-field="studentId" />
        </view>
        
        <view class="form-group">
          <text class="form-label">班级</text>
          <picker class="form-picker" range="{{classOptions}}" value="{{studentForm.classIndex}}" bindchange="onFormClassChange">
            <view class="picker-display">{{studentForm.className || '请选择班级'}}</view>
          </picker>
        </view>
        
        <view class="form-group">
          <text class="form-label">性别</text>
          <view class="radio-group">
            <label class="radio-label">
              <radio class="form-radio" value="male" checked="{{studentForm.gender === 'male'}}" bindchange="onGenderChange" />
              <text>男</text>
            </label>
            <label class="radio-label">
              <radio class="form-radio" value="female" checked="{{studentForm.gender === 'female'}}" bindchange="onGenderChange" />
              <text>女</text>
            </label>
          </view>
        </view>
        
        <view class="form-group">
          <text class="form-label">联系电话</text>
          <input class="form-input" placeholder="请输入联系电话" value="{{studentForm.phone}}" bindinput="onFormInput" data-field="phone" />
        </view>
        
        <view class="form-group">
          <text class="form-label">电子邮箱</text>
          <input class="form-input" placeholder="请输入电子邮箱" value="{{studentForm.email}}" bindinput="onFormInput" data-field="email" />
        </view>
        
        <view class="form-group">
          <text class="form-label">入学日期</text>
          <picker class="form-picker" mode="date" value="{{studentForm.enrollmentDate}}" bindchange="onDateChange">
            <view class="picker-display">{{studentForm.enrollmentDate || '选择入学日期'}}</view>
          </picker>
        </view>
        
        <view class="form-group">
          <text class="form-label">学生状态</text>
          <view class="radio-group">
            <label class="radio-label">
              <radio class="form-radio" value="active" checked="{{studentForm.status === 'active'}}" bindchange="onStatusChange" />
              <text>在读</text>
            </label>
            <label class="radio-label">
              <radio class="form-radio" value="inactive" checked="{{studentForm.status === 'inactive'}}" bindchange="onStatusChange" />
              <text>休学</text>
            </label>
          </view>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="modal-btn cancel-btn" bindtap="hideStudentModal">取消</button>
        <button class="modal-btn confirm-btn" bindtap="saveStudent">保存</button>
      </view>
    </view>
  </view>
</view>
/* notice.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* 页面标题 */
.page-header {
  margin-bottom: 30rpx;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 筛选区域 */
.filter-section {
  margin-bottom: 30rpx;
}

.filter-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.filter-btn {
  flex: 1;
  background: #f8f9fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 15rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.filter-btn::after {
  border: none;
}

.filter-btn.active {
  background: #1890ff;
  border-color: #1890ff;
  color: white;
}

.search-box {
  position: relative;
}

.search-input {
  width: 100%;
  height: 80rpx;
  background: white;
  border-radius: 15rpx;
  padding: 0 80rpx 0 30rpx;
  font-size: 28rpx;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
}

/* 添加通知区域 */
.add-notice-section {
  margin-bottom: 30rpx;
}

.add-notice-btn {
  width: 100%;
  background: linear-gradient(135deg, #fa8c16, #faad14);
  border: none;
  border-radius: 15rpx;
  padding: 25rpx;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
}

.add-notice-btn::after {
  border: none;
}

.add-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 通知列表 */
.notice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notice-card {
  background: white;
  border-radius: 15rpx;
  padding: 30rpx;
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border-left: 8rpx solid #e8e8e8;
}

.notice-card.unread {
  border-left-color: #1890ff;
  background: #f0f8ff;
}

.notice-card:active {
  transform: translateY(-5rpx);
  box-shadow: 0 10rpx 25rpx rgba(0, 0, 0, 0.15);
}

.notice-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.notice-title-section {
  flex: 1;
}

.notice-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.notice-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
}

.tag.system {
  background: #f0f2f5;
  color: #666;
}

.tag.course {
  background: #f6ffed;
  color: #52c41a;
}

.tag.important {
  background: #fff2e8;
  color: #fa8c16;
}

.tag.unread {
  background: #e6f7ff;
  color: #1890ff;
}

.notice-time {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
  margin-left: 20rpx;
}

.notice-content {
  margin-bottom: 20rpx;
}

.content-preview {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.notice-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.notice-source {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999;
}

.source-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.course-name {
  color: #1890ff;
}

.action-buttons {
  display: flex;
  gap: 10rpx;
}

.action-btn {
  border: none;
  border-radius: 5rpx;
  padding: 10rpx 15rpx;
  font-size: 22rpx;
  text-align: center;
}

.action-btn::after {
  border: none;
}

.edit-btn {
  background: #1890ff;
  color: white;
}

.delete-btn {
  background: #ff4d4f;
  color: white;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-subtext {
  display: block;
  font-size: 24rpx;
  color: #ccc;
}

/* 模态框样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 1000;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  background: none;
  border: none;
  font-size: 40rpx;
  color: #999;
  padding: 0;
  width: 40rpx;
  height: 40rpx;
}

.close-btn::after {
  border: none;
}

.modal-body {
  padding: 30rpx;
}

.form-group {
  margin-bottom: 25rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.form-input, .form-textarea {
  width: 100%;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.form-input {
  height: 80rpx;
}

.form-textarea {
  height: 150rpx;
  resize: none;
}

.form-input:focus, .form-textarea:focus {
  border-color: #1890ff;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.checkbox-group {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.form-checkbox {
  transform: scale(1.2);
}

.checkbox-label {
  font-size: 26rpx;
  color: #333;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  border: none;
  border-radius: 10rpx;
  padding: 25rpx;
  font-size: 26rpx;
  font-weight: bold;
}

.modal-btn::after {
  border: none;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: #1890ff;
  color: white;
}

/* AI助手入口 */
.ai-assistant-entry {
  margin-bottom: 30rpx;
}

.ai-entry-btn {
  width: 100%;
  background: linear-gradient(135deg, #722ed1, #9254de);
  border: none;
  border-radius: 15rpx;
  padding: 25rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 15rpx rgba(114, 46, 209, 0.3);
}

.ai-entry-btn::after {
  border: none;
}

.ai-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: white;
  padding: 10rpx;
}

.ai-entry-info {
  flex: 1;
  margin-left: 20rpx;
}

.ai-entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 5rpx;
}

.ai-entry-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.ai-entry-arrow {
  font-size: 40rpx;
  color: white;
  font-weight: 300;
}

/* AI助手模态框 */
.ai-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 2000;
}

.ai-modal.show {
  opacity: 1;
  visibility: visible;
}

.ai-modal-content {
  background: white;
  width: 100%;
  height: 85vh;
  border-radius: 30rpx 30rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

/* AI助手头部 */
.ai-modal-header {
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ai-header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ai-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #722ed1, #9254de);
  padding: 15rpx;
}

.ai-header-info {
  display: flex;
  flex-direction: column;
}

.ai-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.ai-status {
  font-size: 22rpx;
  color: #52c41a;
}

.ai-header-actions {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.ai-action-btn {
  background: #f0f0f0;
  border: none;
  border-radius: 20rpx;
  padding: 10rpx 25rpx;
  font-size: 24rpx;
  color: #666;
}

.ai-action-btn::after {
  border: none;
}

.ai-close-btn {
  background: none;
  border: none;
  font-size: 50rpx;
  color: #999;
  padding: 0;
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
}

.ai-close-btn::after {
  border: none;
}

/* 聊天内容区域 */
.ai-chat-content {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

/* 欢迎界面 */
.ai-welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.welcome-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #722ed1, #9254de);
  padding: 25rpx;
  margin-bottom: 30rpx;
}

.welcome-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.welcome-subtext {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.welcome-tips {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.tip-item {
  background: #f5f5f5;
  color: #666;
  padding: 15rpx 25rpx;
  border-radius: 25rpx;
  font-size: 24rpx;
}

/* 聊天消息 */
.chat-messages {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  gap: 15rpx;
}

.message-item.user {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-avatar-small image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #722ed1, #9254de);
}

.user-avatar-small {
  background: #1890ff;
  color: white;
  font-size: 24rpx;
}

.message-bubble {
  max-width: 70%;
  padding: 20rpx 25rpx;
  border-radius: 15rpx;
  position: relative;
}

.message-bubble.ai {
  background: #f5f5f5;
  border-top-left-radius: 5rpx;
}

.message-bubble.user {
  background: linear-gradient(135deg, #722ed1, #9254de);
  color: white;
  border-top-right-radius: 5rpx;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  word-wrap: break-word;
}

.message-bubble.user .message-text {
  color: white;
}

.message-time {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 10rpx;
}

.message-bubble.user .message-time {
  color: rgba(255, 255, 255, 0.7);
}

/* 加载动画 */
.ai-loading {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 15rpx;
  width: fit-content;
  margin-top: 30rpx;
}

.typing-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #722ed1;
  border-radius: 50%;
  animation: typing 1.4s infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
  }
  30% {
    transform: translateY(-10rpx);
  }
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

/* 输入区域 */
.ai-input-area {
  padding: 20rpx 30rpx;
  border-top: 2rpx solid #f0f0f0;
  background: white;
}

.ai-input-box {
  display: flex;
  align-items: center;
  gap: 15rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 10rpx;
}

.ai-message-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: transparent;
}

.ai-send-btn {
  background: linear-gradient(135deg, #722ed1, #9254de);
  border: none;
  border-radius: 25rpx;
  padding: 15rpx 35rpx;
  color: white;
  font-size: 26rpx;
  font-weight: bold;
}

.ai-send-btn::after {
  border: none;
}

.ai-send-btn.disabled {
  background: #d9d9d9;
  color: #999;
}
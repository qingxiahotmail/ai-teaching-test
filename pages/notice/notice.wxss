/* notice.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* 页面标题 */
.page-header {
  margin-bottom: 30rpx;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 筛选区域 */
.filter-section {
  margin-bottom: 30rpx;
}

.filter-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.filter-btn {
  flex: 1;
  background: #f8f9fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 15rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.filter-btn::after {
  border: none;
}

.filter-btn.active {
  background: #1890ff;
  border-color: #1890ff;
  color: white;
}

.search-box {
  position: relative;
}

.search-input {
  width: 100%;
  height: 80rpx;
  background: white;
  border-radius: 15rpx;
  padding: 0 80rpx 0 30rpx;
  font-size: 28rpx;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
}

/* 添加通知区域 */
.add-notice-section {
  margin-bottom: 30rpx;
}

.add-notice-btn {
  width: 100%;
  background: linear-gradient(135deg, #fa8c16, #faad14);
  border: none;
  border-radius: 15rpx;
  padding: 25rpx;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
}

.add-notice-btn::after {
  border: none;
}

.add-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 通知列表 */
.notice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notice-card {
  background: white;
  border-radius: 15rpx;
  padding: 30rpx;
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border-left: 8rpx solid #e8e8e8;
}

.notice-card.unread {
  border-left-color: #1890ff;
  background: #f0f8ff;
}

.notice-card:active {
  transform: translateY(-5rpx);
  box-shadow: 0 10rpx 25rpx rgba(0, 0, 0, 0.15);
}

.notice-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.notice-title-section {
  flex: 1;
}

.notice-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.notice-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
}

.tag.system {
  background: #f0f2f5;
  color: #666;
}

.tag.course {
  background: #f6ffed;
  color: #52c41a;
}

.tag.important {
  background: #fff2e8;
  color: #fa8c16;
}

.tag.unread {
  background: #e6f7ff;
  color: #1890ff;
}

.notice-time {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
  margin-left: 20rpx;
}

.notice-content {
  margin-bottom: 20rpx;
}

.content-preview {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.notice-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.notice-source {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999;
}

.source-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.course-name {
  color: #1890ff;
}

.action-buttons {
  display: flex;
  gap: 10rpx;
}

.action-btn {
  border: none;
  border-radius: 5rpx;
  padding: 10rpx 15rpx;
  font-size: 22rpx;
  text-align: center;
}

.action-btn::after {
  border: none;
}

.edit-btn {
  background: #1890ff;
  color: white;
}

.delete-btn {
  background: #ff4d4f;
  color: white;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-subtext {
  display: block;
  font-size: 24rpx;
  color: #ccc;
}

/* 模态框样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 1000;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  background: none;
  border: none;
  font-size: 40rpx;
  color: #999;
  padding: 0;
  width: 40rpx;
  height: 40rpx;
}

.close-btn::after {
  border: none;
}

.modal-body {
  padding: 30rpx;
}

.form-group {
  margin-bottom: 25rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.form-input, .form-textarea {
  width: 100%;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.form-input {
  height: 80rpx;
}

.form-textarea {
  height: 150rpx;
  resize: none;
}

.form-input:focus, .form-textarea:focus {
  border-color: #1890ff;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.checkbox-group {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.form-checkbox {
  transform: scale(1.2);
}

.checkbox-label {
  font-size: 26rpx;
  color: #333;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  border: none;
  border-radius: 10rpx;
  padding: 25rpx;
  font-size: 26rpx;
  font-weight: bold;
}

.modal-btn::after {
  border: none;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: #1890ff;
  color: white;
}
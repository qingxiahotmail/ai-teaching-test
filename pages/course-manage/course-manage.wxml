<!-- course-manage.wxml -->
<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="title">课程资料管理</text>
    <button wx:if="{{isTeacher}}" class="add-btn" bindtap="showAddCourseModal">
      + 添加课程
    </button>
  </view>

  <!-- 搜索框 -->
  <view class="search-box">
    <input
      class="search-input"
      placeholder="搜索课程..."
      bindinput="onSearchInput"
      confirm-type="search"
    />
  </view>

  <!-- 课程列表 -->
  <view class="course-list">
    <view
      class="course-card"
      wx:for="{{courses}}"
      wx:key="id"
    >
      <view class="course-header">
        <view class="course-info">
          <text class="course-name">{{item.name}}</text>
          <text class="course-desc">{{item.description}}</text>
          <view class="course-meta">
            <text class="category-tag">{{item.category}}</text>
            <text class="create-time">{{item.createTime}}</text>
          </view>
        </view>
        <view wx:if="{{isTeacher}}" class="course-actions">
          <text class="action-btn materials-btn" bindtap="showMaterialsModal" data-course="{{item}}">资料</text>
          <text class="action-btn edit-btn" bindtap="editCourse" data-course="{{item}}">编辑</text>
          <text class="action-btn delete-btn" bindtap="deleteCourse" data-id="{{item.id}}">删除</text>
        </view>
      </view>

      <!-- 标签 -->
      <view class="tags-row">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
          {{tag}}
        </text>
      </view>

      <!-- 状态 -->
      <view wx:if="{{isTeacher}}" class="status-bar">
        <text class="status-text {{item.status}}">
          {{item.status === 'active' ? '已发布' : '已归档'}}
        </text>
        <switch
          class="status-switch"
          checked="{{item.status === 'active'}}"
          bindchange="toggleStatus"
          data-id="{{item.id}}"
          color="#1890ff"
        />
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{courses.length === 0}}" class="empty-state">
    <text class="empty-icon">📚</text>
    <text class="empty-text">暂无课程</text>
  </view>

  <!-- 添加/编辑模态框 -->
  <view wx:if="{{showAddModal}}" class="modal-overlay" catchtap="hideModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{editingCourse ? '编辑课程' : '添加课程'}}</text>
        <text class="modal-close" catchtap="hideModal">×</text>
      </view>

      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">课程名称 *</text>
          <input
            class="form-input"
            placeholder="请输入课程名称"
            data-field="name"
            bindinput="onFormInput"
            placeholder-style="color: #999"
          />
        </view>

        <view class="form-item">
          <text class="form-label">课程描述 *</text>
          <textarea
            class="form-textarea"
            placeholder="请输入课程描述"
            maxlength="200"
            data-field="description"
            bindinput="onFormInput"
            placeholder-style="color: #999"
          />
        </view>

        <view class="form-item">
          <text class="form-label">课程分类 *</text>
          <picker
            mode="selector"
            range="{{categories}}"
            bindchange="onCategoryChange"
          >
            <view class="picker">
              {{formData.category || '请选择分类'}}
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>

        <view class="form-item">
          <text class="form-label">课程标签</text>
          <input
            class="form-input"
            placeholder="多个标签用逗号分隔"
            data-field="tags"
            bindinput="onFormInput"
            placeholder-style="color: #999"
          />
        </view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn cancel-btn" catchtap="hideModal">取消</button>
        <button class="modal-btn confirm-btn" catchtap="saveCourse">保存</button>
      </view>
    </view>
  </view>

  <!-- 课程资料管理模态框 -->
  <view wx:if="{{showMaterialsModal}}" class="modal-overlay" catchtap="hideMaterialsModal">
    <view class="modal-content materials-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{currentCourse.name}} - 课程资料</text>
        <text class="modal-close" catchtap="hideMaterialsModal">×</text>
      </view>

      <view class="modal-body">
        <view class="materials-list">
          <view class="empty-materials" wx:if="{{materialsList.length === 0}}">
            <text class="empty-icon">📁</text>
            <text class="empty-text">暂无课程资料</text>
          </view>

          <view class="material-item" wx:for="{{materialsList}}" wx:key="id">
            <view class="material-info" bindtap="openMaterialLink" data-material="{{item}}">
              <text class="material-icon">{{item.url ? '🔗' : '📄'}}</text>
              <text class="material-name">{{item.name}}</text>
            </view>
            <view class="material-actions">
              <text class="material-action edit" catchtap="editMaterial" data-id="{{item.id}}">编辑</text>
              <text class="material-action delete" catchtap="deleteMaterial" data-id="{{item.id}}">删除</text>
            </view>
          </view>

        </view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn cancel-btn" catchtap="hideMaterialsModal">关闭</button>
        <button class="modal-btn confirm-btn" catchtap="addMaterial">+ 添加资料</button>
      </view>
    </view>
  </view>
</view>


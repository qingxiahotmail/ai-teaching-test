<!--grade.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">成绩统计</text>
    <text class="page-subtitle">{{userInfo.role === 'teacher' ? '录入和查看学生成绩' : '查看个人成绩'}}</text>
  </view>

  <!-- 筛选区域 -->
  <view class="filter-section">
    <view class="filter-row">
      <picker class="course-picker" range="{{courseOptions}}" value="{{selectedCourseIndex}}" bindchange="onCourseChange">
        <view class="picker-display">{{selectedCourse || '选择课程'}}</view>
      </picker>
      
      <picker class="semester-picker" range="{{semesterOptions}}" value="{{selectedSemesterIndex}}" bindchange="onSemesterChange" wx:if="{{userInfo.role === 'teacher'}}">
        <view class="picker-display">{{selectedSemester || '选择学期'}}</view>
      </picker>
    </view>
    
    <view class="search-box" wx:if="{{userInfo.role === 'teacher'}}">
      <input class="search-input" placeholder="搜索学生姓名或学号" bindinput="onSearchInput" value="{{searchKeyword}}" />
      <image class="search-icon" src="/images/search.png"></image>
    </view>
  </view>

  <!-- 成绩统计概览（教师） -->
  <view class="stats-overview" wx:if="{{userInfo.role === 'teacher'}}">
    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-value">{{stats.averageScore || 0}}</text>
        <text class="stat-label">平均分</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.highestScore || 0}}</text>
        <text class="stat-label">最高分</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.passRate || 0}}%</text>
        <text class="stat-label">及格率</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.totalStudents || 0}}</text>
        <text class="stat-label">学生数</text>
      </view>
    </view>
  </view>

  <!-- 个人成绩概览（学生） -->
  <view class="personal-stats" wx:if="{{userInfo.role === 'student'}}">
    <view class="personal-card">
      <view class="score-display">
        <text class="score-value">{{personalScore || 0}}</text>
        <text class="score-label">当前成绩</text>
      </view>
      <view class="score-details">
        <view class="detail-item">
          <text class="detail-label">班级排名</text>
          <text class="detail-value">{{personalRank || '--'}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-label">课程平均分</text>
          <text class="detail-value">{{courseAverage || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 成绩列表 -->
  <view class="grade-list">
    <!-- 教师视图 -->
    <view wx:if="{{userInfo.role === 'teacher'}}">
      <view class="grade-table">
        <view class="table-header">
          <text class="header-cell">学生姓名</text>
          <text class="header-cell">学号</text>
          <text class="header-cell">平时成绩</text>
          <text class="header-cell">期末成绩</text>
          <text class="header-cell">总成绩</text>
          <text class="header-cell">操作</text>
        </view>
        <view wx:for="{{filteredGrades}}" wx:key="id" class="table-row">
          <text class="table-cell">{{item.studentName}}</text>
          <text class="table-cell">{{item.studentId}}</text>
          <text class="table-cell">
            <input class="score-input" value="{{item.usualScore}}" placeholder="--" bindinput="onScoreInput" data-id="{{item.id}}" data-type="usual" />
          </text>
          <text class="table-cell">
            <input class="score-input" value="{{item.finalScore}}" placeholder="--" bindinput="onScoreInput" data-id="{{item.id}}" data-type="final" />
          </text>
          <text class="table-cell total-score">{{item.totalScore || '--'}}</text>
          <view class="table-cell">
            <button class="action-btn save-btn" bindtap="saveGrade" data-id="{{item.id}}">保存</button>
          </view>
        </view>
      </view>
    </view>

    <!-- 学生视图 -->
    <view wx:if="{{userInfo.role === 'student'}}">
      <view wx:for="{{personalGrades}}" wx:key="id" class="personal-grade-card">
        <view class="grade-header">
          <text class="course-name">{{item.courseName}}</text>
          <text class="semester">{{item.semester}}</text>
        </view>
        <view class="grade-details">
          <view class="detail-row">
            <text class="detail-label">平时成绩</text>
            <text class="detail-value">{{item.usualScore || '--'}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">期末成绩</text>
            <text class="detail-value">{{item.finalScore || '--'}}</text>
          </view>
          <view class="detail-row total-row">
            <text class="detail-label">总成绩</text>
            <text class="detail-value total">{{item.totalScore || '--'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{filteredGrades.length === 0 && userInfo.role === 'teacher'}}">
    <image class="empty-icon" src="/images/empty_grade.png"></image>
    <text class="empty-text">暂无成绩数据</text>
    <text class="empty-subtext">选择课程查看成绩信息</text>
  </view>

  <view class="empty-state" wx:if="{{personalGrades.length === 0 && userInfo.role === 'student'}}">
    <image class="empty-icon" src="/images/empty_grade.png"></image>
    <text class="empty-text">暂无成绩数据</text>
    <text class="empty-subtext">老师尚未发布成绩</text>
  </view>

  <!-- 批量操作（教师） -->
  <view class="batch-actions" wx:if="{{userInfo.role === 'teacher' && filteredGrades.length > 0}}">
    <button class="batch-btn import-btn" bindtap="importGrades">导入成绩</button>
    <button class="batch-btn export-btn" bindtap="exportGrades">导出成绩</button>
  </view>
</view>
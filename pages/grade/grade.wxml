<!--grade.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">学习统计</text>
    <text class="page-subtitle">查看您的学习进度和统计</text>
  </view>

  <!-- 学习统计概览 -->
  <view class="stats-overview">
    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-value">{{personalScore}}</text>
        <text class="stat-label">已完成课程</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{courseAverage}}%</text>
        <text class="stat-label">完成率</text>
      </view>
    </view>
  </view>

  <!-- 学习进度 -->
  <view class="progress-section">
    <view class="section-title">学习进度</view>
    <view class="progress-card">
      <view class="progress-row">
        <text class="progress-label">课程资源</text>
        <view class="progress-bar">
          <view class="progress-fill" style="width: 85%"></view>
        </view>
        <text class="progress-value">85%</text>
      </view>
      <view class="progress-row">
        <text class="progress-label">作业练习</text>
        <view class="progress-bar">
          <view class="progress-fill" style="width: 70%"></view>
        </view>
        <text class="progress-value">70%</text>
      </view>
      <view class="progress-row">
        <text class="progress-label">学习时长</text>
        <view class="progress-bar">
          <view class="progress-fill" style="width: 60%"></view>
        </view>
        <text class="progress-value">60%</text>
      </view>
    </view>
  </view>

  <!-- 学习建议 -->
  <view class="tips-section">
    <view class="section-title">学习建议</view>
    <view class="tips-list">
      <view class="tip-item">
        <text class="tip-icon">💡</text>
        <text class="tip-text">建议每天保持至少2小时的学习时间</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">📚</text>
        <text class="tip-text">及时完成课程作业，巩固学习成果</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">💬</text>
        <text class="tip-text">遇到问题及时在学习问答区提问</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">🎯</text>
        <text class="tip-text">制定学习计划，循序渐进完成课程</text>
      </view>
    </view>
  </view>

  <!-- 空状态提示 -->
  <view wx:if="{{personalScore === 0}}" class="empty-state">
    <text class="empty-icon">📊</text>
    <text class="empty-text">暂无学习数据</text>
    <text class="empty-hint">开始浏览课程和完成作业，学习数据会自动统计</text>
  </view>
</view>

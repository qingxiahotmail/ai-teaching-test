/* index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* Banner样式 */
.banner {
  position: relative;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.banner-content {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  position: relative;
  z-index: 2;
}

.welcome-badge {
  font-size: 60rpx;
  margin-bottom: 16rpx;
  display: block;
}

.welcome-title {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.welcome-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 300;
}

.banner-decoration {
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 70%);
  border-radius: 50%;
  z-index: 1;
}

/* 数据统计样式 */
.stats-section {
  margin-bottom: 30rpx;
}

.stats-card {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stats-icon {
  font-size: 48rpx;
  opacity: 0.8;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin: 0 auto 12rpx;
}

.course-icon {
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.homework-icon {
  background: linear-gradient(135deg, #f093fb, #f5576c);
}

.completed-icon {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
}

.stat-value {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #667eea, #764ba2);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.stat-divider {
  width: 2rpx;
  height: 80rpx;
  background: linear-gradient(to bottom, transparent, #e0e0e0, transparent);
}

/* 最近学习区域 */
.recent-section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-icon {
  font-size: 36rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.more-link {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.course-list {
  white-space: nowrap;
  padding-bottom: 10rpx;
}

.course-item {
  display: inline-block;
  width: 300rpx;
  margin-right: 20rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  vertical-align: top;
}

.course-cover-box {
  position: relative;
  width: 100%;
  height: 180rpx;
  overflow: hidden;
}

.course-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.course-progress-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  padding: 20rpx;
  padding-top: 40rpx;
}

.progress-badge {
  background: rgba(255, 255, 255, 0.95);
  color: #667eea;
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
}

.course-info {
  padding: 24rpx;
}

.course-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-tag {
  font-size: 22rpx;
  color: #52c41a;
  background: #f6ffed;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #b7eb8f;
}

/* 快捷功能区域 */
.features-section {
  margin-bottom: 30rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.feature-card {
  background: white;
  border-radius: 20rpx;
  padding: 36rpx 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.feature-card:active {
  transform: translateY(-8rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
}

.feature-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.course-feature {
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.homework-feature {
  background: linear-gradient(135deg, #f093fb, #f5576c);
}

.notice-feature {
  background: linear-gradient(135deg, #fa709a, #fee140);
}

.grade-feature {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
}

.feature-icon {
  width: 60rpx;
  height: 60rpx;
}

.feature-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.feature-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 教师管理区域 */
.teacher-section {
  margin-bottom: 30rpx;
}

.teacher-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.teacher-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.teacher-icon {
  width: 80rpx;
  height: 80rpx;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 50%;
}

.teacher-info {
  flex: 1;
}

.teacher-status {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.teacher-status::before {
  content: '';
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: linear-gradient(135deg, #52c41a, #73d13d);
  vertical-align: middle;
}

.teacher-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

.teacher-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.teacher-mode-btn {
  flex: 1;
  min-width: 220rpx;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: 3rpx solid #1890ff;
  color: #1890ff;
  background: white;
  transition: all 0.3s ease;
  font-weight: 500;
}

.teacher-mode-btn::after {
  border: none;
}

.teacher-mode-btn.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-color: transparent;
}

.manage-btn {
  flex: 1;
  min-width: 220rpx;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border: none;
  font-weight: 500;
}

.manage-btn::after {
  border: none;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
  padding: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}


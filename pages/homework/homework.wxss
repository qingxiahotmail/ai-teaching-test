/* homework.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* 页面标题 */
.page-header {
  margin-bottom: 30rpx;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 筛选区域 */
.filter-section {
  margin-bottom: 30rpx;
}

.filter-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.course-picker, .status-picker {
  flex: 1;
  background: white;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}

.picker-display {
  color: #666;
}

.search-box {
  position: relative;
}

.search-input {
  width: 100%;
  height: 80rpx;
  background: white;
  border-radius: 15rpx;
  padding: 0 80rpx 0 30rpx;
  font-size: 28rpx;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
}

.search-input:focus {
  border-color: #1890ff;
}

.search-icon {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
}

/* 添加作业区域 */
.add-homework-section {
  margin-bottom: 30rpx;
}

.add-homework-btn {
  width: 100%;
  background: linear-gradient(135deg, #1890ff, #40a9ff);
  border: none;
  border-radius: 15rpx;
  padding: 25rpx;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
}

.add-homework-btn::after {
  border: none;
}

.add-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 作业列表 */
.homework-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.homework-card {
  background: white;
  border-radius: 15rpx;
  padding: 30rpx;
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.homework-card:active {
  transform: translateY(-5rpx);
  box-shadow: 0 10rpx 25rpx rgba(0, 0, 0, 0.15);
}

.homework-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.homework-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.homework-course {
  font-size: 24rpx;
  color: #666;
  background: #f0f2f5;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  margin-left: 15rpx;
}

.homework-info {
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.info-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 15rpx;
}

.description {
  flex: 1;
  color: #999;
  font-size: 22rpx;
  line-height: 1.4;
}

.homework-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.status-badge.pending {
  background: #fff7e6;
  color: #fa8c16;
  border: 1rpx solid #ffd591;
}

.status-badge.submitted {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.status-badge.overdue {
  background: #fff2f0;
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
}

.submission-count, .submission-status {
  font-size: 24rpx;
  color: #666;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  flex: 1;
  border: none;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 24rpx;
  text-align: center;
}

.action-btn::after {
  border: none;
}

.edit-btn {
  background: #1890ff;
  color: white;
}

.delete-btn {
  background: #ff4d4f;
  color: white;
}

.detail-btn, .view-btn {
  background: #52c41a;
  color: white;
}

.submit-btn {
  background: #fa8c16;
  color: white;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-subtext {
  display: block;
  font-size: 24rpx;
  color: #ccc;
}

/* 模态框样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 1000;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  background: none;
  border: none;
  font-size: 40rpx;
  color: #999;
  padding: 0;
  width: 40rpx;
  height: 40rpx;
}

.close-btn::after {
  border: none;
}

.modal-body {
  padding: 30rpx;
}

.form-group {
  margin-bottom: 25rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.form-input, .form-textarea {
  width: 100%;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.form-input {
  height: 80rpx;
}

.form-textarea {
  height: 120rpx;
  resize: none;
}

.form-input:focus, .form-textarea:focus {
  border-color: #1890ff;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  border: none;
  border-radius: 10rpx;
  padding: 25rpx;
  font-size: 26rpx;
  font-weight: bold;
}

.modal-btn::after {
  border: none;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: #1890ff;
  color: white;
}
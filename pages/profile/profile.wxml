<view class="profile-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-avatar">
      <image src="{{userInfo.avatar || '/images/avatar-default.png'}}" class="avatar-image" mode="aspectFill" />
      <view class="user-info">
        <text class="user-name">{{userInfo.name || '教师用户'}}</text>
        <text class="user-title">{{userInfo.title || '讲师'}}</text>
        <text class="user-id">工号: {{userInfo.teacherId || 'T001'}}</text>
      </view>
    </view>
    <view class="user-stats">
      <view class="stat-item">
        <text class="stat-number">{{stats.courseCount}}</text>
        <text class="stat-label">课程</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.studentCount}}</text>
        <text class="stat-label">学生</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.homeworkCount}}</text>
        <text class="stat-label">作业</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-title">常用功能</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="onMenuTap" data-page="course">
        <view class="menu-icon">📚</view>
        <view class="menu-text">课程管理</view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-item" bindtap="onMenuTap" data-page="student">
        <view class="menu-icon">👥</view>
        <view class="menu-text">学生管理</view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-item" bindtap="onMenuTap" data-page="homework">
        <view class="menu-icon">📝</view>
        <view class="menu-text">作业管理</view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-item" bindtap="onMenuTap" data-page="grade">
        <view class="menu-icon">📊</view>
        <view class="menu-text">成绩统计</view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 设置菜单 -->
  <view class="menu-section">
    <view class="menu-title">设置</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="onEditProfile">
        <view class="menu-icon">✏️</view>
        <view class="menu-text">编辑资料</view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-item" bindtap="onSettings">
        <view class="menu-icon">⚙️</view>
        <view class="menu-text">系统设置</view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-item" bindtap="onHelp">
        <view class="menu-icon">❓</view>
        <view class="menu-text">帮助中心</view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-item" bindtap="onAbout">
        <view class="menu-icon">ℹ️</view>
        <view class="menu-text">关于我们</view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>